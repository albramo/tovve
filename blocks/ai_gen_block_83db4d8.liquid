{% doc %}
  @prompt
    اعملي Collapsible row مكان الوصف انا خفيته حطلي Collapsible row مكانه تمام, المتجر بالانجليزي ي بهيم عملي الكتابه يمين يغي ظبطها انجليزي\
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collapsible-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collapsible-row-item-{{ ai_gen_id }} {
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-collapsible-row-item-{{ ai_gen_id }}:first-child {
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-collapsible-row-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.row_padding }}px 0;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    color: {{ block.settings.heading_color }};
  }

  .ai-collapsible-row-header-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-collapsible-row-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0;
    flex-grow: 1;
  }

  .ai-collapsible-row-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 12px;
  }

  .ai-collapsible-row-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-collapsible-row-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-collapsible-row-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-collapsible-row-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-collapsible-row-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-collapsible-row-content-inner-{{ ai_gen_id }} {
    padding: 0 0 {{ block.settings.row_padding }}px 0;
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
  }

  .ai-collapsible-row-content-inner-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-collapsible-row-content-inner-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }
{% endstyle %}

<collapsible-rows-{{ ai_gen_id }} class="ai-collapsible-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..5) %}
    {% liquid
      assign row_enabled_key = 'row_' | append: i | append: '_enabled'
      assign row_title_key = 'row_' | append: i | append: '_title'
      assign row_content_key = 'row_' | append: i | append: '_content'
      assign row_open_key = 'row_' | append: i | append: '_open_by_default'

      assign row_enabled = block.settings[row_enabled_key]
      assign row_title = block.settings[row_title_key]
      assign row_content = block.settings[row_content_key]
      assign row_open = block.settings[row_open_key]
    %}

    {% if row_enabled %}
      <div class="ai-collapsible-row-item-{{ ai_gen_id }}">
        <button
          class="ai-collapsible-row-header-{{ ai_gen_id }}"
          aria-expanded="{% if row_open %}true{% else %}false{% endif %}"
          data-row-id="{{ i }}"
        >
          <h3 class="ai-collapsible-row-title-{{ ai_gen_id }}">{{ row_title }}</h3>
          <span class="ai-collapsible-row-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="ai-collapsible-row-content-{{ ai_gen_id }} {% if row_open %}active{% endif %}">
          <div class="ai-collapsible-row-content-inner-{{ ai_gen_id }}">
            {{ row_content }}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</collapsible-rows-{{ ai_gen_id }}>

<script>
  (function() {
    class CollapsibleRows{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.headers = this.querySelectorAll('.ai-collapsible-row-header-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.headers.forEach((header) => {
          header.addEventListener('click', () => {
            const content = header.nextElementSibling;
            const isExpanded = header.getAttribute('aria-expanded') === 'true';

            header.setAttribute('aria-expanded', !isExpanded);
            content.classList.toggle('active');
          });
        });
      }
    }

    customElements.define('collapsible-rows-{{ ai_gen_id }}', CollapsibleRows{{ ai_gen_id }});
  })();
</script>

