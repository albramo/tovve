{% doc %}
  @prompt
    Create a product information block that displays as horizontal tabs on desktop (with tab buttons: Description, Ingredients, How to Use, Features, Reviews — shown in a row at the top, with the active tab content displayed below), and switches to a collapsible accordion style on mobile. The tab/accordion content should be editable via theme settings. Match a clean, minimal luxury skincare aesthetic with subtle borders and smooth transitions.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
    background-color: #f6f6f8;
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-tabs__nav-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-product-tabs__nav-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-tabs__button-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: 12px 20px;
    cursor: pointer;
    font-family: {{ block.settings.tab_font.family }}, {{ block.settings.tab_font.fallback_families }};
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.tab_text_color }};
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
    white-space: nowrap;
    position: relative;
  }

  .ai-product-tabs__button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_active_color }};
  }

  .ai-product-tabs__button-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_color }};
  }

  .ai-product-tabs__content-{{ ai_gen_id }} {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-tabs__content-{{ ai_gen_id }}.active {
    display: block;
    opacity: 1;
  }

  .ai-product-tabs__text-{{ ai_gen_id }} {
    font-family: {{ block.settings.content_font.family }}, {{ block.settings.content_font.fallback_families }};
    font-size: {{ block.settings.content_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.content_text_color }};
    font-weight: 500;
  }

  .ai-product-tabs__accordion-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-tabs__accordion-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-product-tabs__accordion-header-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: 16px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: {{ block.settings.tab_font.family }}, {{ block.settings.tab_font.fallback_families }};
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 500;
    color: {{ block.settings.tab_text_color }};
    text-align: left;
  }

  .ai-product-tabs__accordion-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    stroke: {{ block.settings.tab_text_color }};
  }

  .ai-product-tabs__accordion-header-{{ ai_gen_id }}.active .ai-product-tabs__accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-product-tabs__accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-product-tabs__accordion-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-product-tabs__accordion-text-{{ ai_gen_id }} {
    padding-bottom: 16px;
    font-family: {{ block.settings.content_font.family }}, {{ block.settings.content_font.fallback_families }};
    font-size: {{ block.settings.content_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.content_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-tabs__nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-product-tabs__tabs-content-{{ ai_gen_id }} {
      display: none;
    }

    .ai-product-tabs__accordion-{{ ai_gen_id }} {
      display: block;
    }

    .ai-product-tabs-{{ ai_gen_id }} {
      width: 100vw;
      max-width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      padding: 20px 16px;
      box-sizing: border-box;
      margin-top: 12px;
      background-color: #f6f6f8;
    }

    .ai-product-tabs__accordion-header-{{ ai_gen_id }} {
      font-size: 16px;
      font-weight: 700;
      padding: 18px 0;
    }

    .ai-product-tabs__accordion-text-{{ ai_gen_id }} {
      font-size: 15px;
      padding-bottom: 20px;
      font-weight: 500;
    }
  }
{% endstyle %}

<product-tabs-{{ ai_gen_id }} class="ai-product-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-tabs__nav-{{ ai_gen_id }}">
    {% if block.settings.show_description %}
      <button class="ai-product-tabs__button-{{ ai_gen_id }} active" data-tab="description">
        {{ block.settings.description_label }}
      </button>
    {% endif %}
    {% if block.settings.show_ingredients %}
      <button class="ai-product-tabs__button-{{ ai_gen_id }}" data-tab="ingredients">
        {{ block.settings.ingredients_label }}
      </button>
    {% endif %}
    {% if block.settings.show_how_to_use %}
      <button class="ai-product-tabs__button-{{ ai_gen_id }}" data-tab="how-to-use">
        {{ block.settings.how_to_use_label }}
      </button>
    {% endif %}
    {% if block.settings.show_features %}
      <button class="ai-product-tabs__button-{{ ai_gen_id }}" data-tab="features">
        {{ block.settings.features_label }}
      </button>
    {% endif %}
    {% if block.settings.show_reviews %}
      <button class="ai-product-tabs__button-{{ ai_gen_id }}" data-tab="reviews">
        {{ block.settings.reviews_label }}
      </button>
    {% endif %}
  </div>

  <div class="ai-product-tabs__tabs-content-{{ ai_gen_id }}">
    {% if block.settings.show_description %}
      <div class="ai-product-tabs__content-{{ ai_gen_id }} active" data-content="description">
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">
          {% if block.settings.description_content != blank %}
            {{ block.settings.description_content }}
          {% else %}
            {{ product.description }}
          {% endif %}
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_ingredients %}
      <div class="ai-product-tabs__content-{{ ai_gen_id }}" data-content="ingredients">
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">
          {{ block.settings.ingredients_content }}
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_how_to_use %}
      <div class="ai-product-tabs__content-{{ ai_gen_id }}" data-content="how-to-use">
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">
          {{ block.settings.how_to_use_content }}
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_features %}
      <div class="ai-product-tabs__content-{{ ai_gen_id }}" data-content="features">
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">
          {{ block.settings.features_content }}
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_reviews %}
      <div class="ai-product-tabs__content-{{ ai_gen_id }}" data-content="reviews">
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">
          {{ block.settings.reviews_content }}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-product-tabs__accordion-{{ ai_gen_id }}">
    {% if block.settings.show_description %}
      <div class="ai-product-tabs__accordion-item-{{ ai_gen_id }}">
        <button class="ai-product-tabs__accordion-header-{{ ai_gen_id }} active" data-accordion="description">
          <span>{{ block.settings.description_label }}</span>
          <svg class="ai-product-tabs__accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="ai-product-tabs__accordion-content-{{ ai_gen_id }} active" data-accordion-content="description">
          <div class="ai-product-tabs__accordion-text-{{ ai_gen_id }}">
            {% if block.settings.description_content != blank %}
              {{ block.settings.description_content }}
            {% else %}
              {{ product.description }}
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_ingredients %}
      <div class="ai-product-tabs__accordion-item-{{ ai_gen_id }}">
        <button class="ai-product-tabs__accordion-header-{{ ai_gen_id }}" data-accordion="ingredients">
          <span>{{ block.settings.ingredients_label }}</span>
          <svg class="ai-product-tabs__accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="ai-product-tabs__accordion-content-{{ ai_gen_id }}" data-accordion-content="ingredients">
          <div class="ai-product-tabs__accordion-text-{{ ai_gen_id }}">
            {{ block.settings.ingredients_content }}
          </div>
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_how_to_use %}
      <div class="ai-product-tabs__accordion-item-{{ ai_gen_id }}">
        <button class="ai-product-tabs__accordion-header-{{ ai_gen_id }}" data-accordion="how-to-use">
          <span>{{ block.settings.how_to_use_label }}</span>
          <svg class="ai-product-tabs__accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="ai-product-tabs__accordion-content-{{ ai_gen_id }}" data-accordion-content="how-to-use">
          <div class="ai-product-tabs__accordion-text-{{ ai_gen_id }}">
            {{ block.settings.how_to_use_content }}
          </div>
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_features %}
      <div class="ai-product-tabs__accordion-item-{{ ai_gen_id }}">
        <button class="ai-product-tabs__accordion-header-{{ ai_gen_id }}" data-accordion="features">
          <span>{{ block.settings.features_label }}</span>
          <svg class="ai-product-tabs__accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="ai-product-tabs__accordion-content-{{ ai_gen_id }}" data-accordion-content="features">
          <div class="ai-product-tabs__accordion-text-{{ ai_gen_id }}">
            {{ block.settings.features_content }}
          </div>
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_reviews %}
      <div class="ai-product-tabs__accordion-item-{{ ai_gen_id }}">
        <button class="ai-product-tabs__accordion-header-{{ ai_gen_id }}" data-accordion="reviews">
          <span>{{ block.settings.reviews_label }}</span>
          <svg class="ai-product-tabs__accordion-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="ai-product-tabs__accordion-content-{{ ai_gen_id }}" data-accordion-content="reviews">
          <div class="ai-product-tabs__accordion-text-{{ ai_gen_id }}">
            {{ block.settings.reviews_content }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</product-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabButtons = this.querySelectorAll('.ai-product-tabs__button-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-product-tabs__content-{{ ai_gen_id }}');
        this.accordionHeaders = this.querySelectorAll('.ai-product-tabs__accordion-header-{{ ai_gen_id }}');
        this.accordionContents = this.querySelectorAll('.ai-product-tabs__accordion-content-{{ ai_gen_id }}');

        this.setupTabs();
        this.setupAccordion();
      }

      setupTabs() {
        this.tabButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabName = button.getAttribute('data-tab');

            this.tabButtons.forEach((btn) => btn.classList.remove('active'));
            this.tabContents.forEach((content) => content.classList.remove('active'));

            button.classList.add('active');
            const activeContent = this.querySelector(
              '.ai-product-tabs__content-{{ ai_gen_id }}[data-content="' + tabName + '"]'
            );
            if (activeContent) {
              activeContent.classList.add('active');
            }
          });
        });
      }

      setupAccordion() {
        this.accordionHeaders.forEach((header) => {
          header.addEventListener('click', () => {
            const accordionName = header.getAttribute('data-accordion');
            const content = this.querySelector(
              '.ai-product-tabs__accordion-content-{{ ai_gen_id }}[data-accordion-content="' +
                accordionName +
                '"]'
            );

            const isActive = header.classList.contains('active');

            if (isActive) {
              header.classList.remove('active');
              content.classList.remove('active');
            } else {
              header.classList.add('active');
              content.classList.add('active');
            }
          });
        });
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product info tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text",
      "default": "#4a3a3a"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab",
      "default": "#2e0808"
    },
    {
      "type": "color",
      "id": "content_text_color",
      "label": "Content text",
      "default": "#2e0808"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "tab_font",
      "label": "Tab font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "label": "Tab font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "font_picker",
      "id": "content_font",
      "label": "Content font",
      "default": "poppins_n4"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "label": "Content font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Description tab"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "text",
      "id": "description_label",
      "label": "Label",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "description_content",
      "label": "Content",
      "info": "Leave empty to use product description"
    },
    {
      "type": "header",
      "content": "Ingredients tab"
    },
    {
      "type": "checkbox",
      "id": "show_ingredients",
      "label": "Show ingredients",
      "default": true
    },
    {
      "type": "text",
      "id": "ingredients_label",
      "label": "Label",
      "default": "Ingredients"
    },
    {
      "type": "richtext",
      "id": "ingredients_content",
      "label": "Content",
      "default": "<p>Add your ingredients list here.</p>"
    },
    {
      "type": "header",
      "content": "How to use tab"
    },
    {
      "type": "checkbox",
      "id": "show_how_to_use",
      "label": "Show how to use",
      "default": true
    },
    {
      "type": "text",
      "id": "how_to_use_label",
      "label": "Label",
      "default": "How to Use"
    },
    {
      "type": "richtext",
      "id": "how_to_use_content",
      "label": "Content",
      "default": "<p>Add usage instructions here.</p>"
    },
    {
      "type": "header",
      "content": "Features tab"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show features",
      "default": true
    },
    {
      "type": "text",
      "id": "features_label",
      "label": "Label",
      "default": "Features"
    },
    {
      "type": "richtext",
      "id": "features_content",
      "label": "Content",
      "default": "<p>Add product features here.</p>"
