{% doc %}
  @prompt
    Edit the existing breadcrumb navigation block on the product page to show the full collection path: Home > Collection Name > Product Name. The breadcrumb should automatically detect the collection the product belongs to using product.collections in Liquid and display it in the path. If the product belongs to multiple collections, show the first one. Keep all existing styling exactly the same.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-breadcrumb-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-breadcrumb-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ block.settings.spacing }}px;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-breadcrumb-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-breadcrumb-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: {{ block.settings.link_hover_underline }};
  }

  .ai-breadcrumb-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    user-select: none;
  }

  .ai-breadcrumb-current-{{ ai_gen_id }} {
    color: {{ block.settings.current_page_color }};
  }
{% endstyle %}

<nav
  class="ai-breadcrumb-{{ ai_gen_id }}"
  aria-label="Breadcrumb"
  {{ block.shopify_attributes }}
>
  <ol class="ai-breadcrumb-nav-{{ ai_gen_id }}">
    <li>
      <a href="{{ routes.root_url }}" class="ai-breadcrumb-link-{{ ai_gen_id }}">
        {{ block.settings.home_text }}
      </a>
    </li>

    {% if product %}
      {% if product.collections.size > 0 %}
        {% assign first_collection = product.collections.first %}
        <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
          {{ block.settings.separator }}
        </li>
        <li>
          <a href="{{ first_collection.url }}" class="ai-breadcrumb-link-{{ ai_gen_id }}">
            {{ first_collection.title }}
          </a>
        </li>
      {% endif %}

      <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
        {{ block.settings.separator }}
      </li>
      <li>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}" aria-current="page">
          {{ product.title }}
        </span>
      </li>
    {% elsif collection %}
      <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
        {{ block.settings.separator }}
      </li>
      <li>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}" aria-current="page">
          {{ collection.title }}
        </span>
      </li>
    {% elsif page %}
      <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
        {{ block.settings.separator }}
      </li>
      <li>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}" aria-current="page">
          {{ page.title }}
        </span>
      </li>
    {% elsif article %}
      <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
        {{ block.settings.separator }}
      </li>
      <li>
        <a href="{{ blog.url }}" class="ai-breadcrumb-link-{{ ai_gen_id }}">
          {{ blog.title }}
        </a>
      </li>
      <li class="ai-breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">
        {{ block.settings.separator }}
      </li>
      <li>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}" aria-current="page">
          {{ article.title }}
        </span>
      </li>
    {% endif %}
  </ol>
</nav>

{% schema %}
{
  "name": "Breadcrumb navigation",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": ">"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing between items",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4A3A3A"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#2E0808"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#4A3A3A"
    },
    {
      "type": "select",
      "id": "link_hover_underline",
      "label": "Link hover underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#4A3A3A"
    },
    {
      "type": "color",
      "id": "current_page_color",
      "label": "Current page color",
      "default": "#4A3A3A"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb navigation"
    }
  ]
}
{% endschema %}
