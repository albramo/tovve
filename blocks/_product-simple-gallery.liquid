{% comment %}
  Product Simple Gallery Block
  صورة رئيسية كبيرة مع thumbnails تحتها - تصميم بسيط واحترافي زي Sephora
{% endcomment %}

{% render 'product-simple-gallery',
  block_settings: block.settings,
  block_id: block.id,
  block_shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Product Gallery (Simple)",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Main Image Settings"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Auto"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "16/9",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "main_image_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable Zoom on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Thumbnails Settings"
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail Size",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "label": "Gap Between Thumbnails",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Thumbnail Border Radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "thumbnail_border_color",
      "label": "Active Thumbnail Border Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Gallery (Simple)"
    }
  ]
}
{% endschema %}
