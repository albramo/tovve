{% doc %}
  @prompt
    اضيف تحت هنا او تواصل علي الايميل tovee.cosmetics@gmail.com بالانلجيزي طبعا
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-info-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-info__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-contact-info__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-contact-info__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    margin-top: 2px;
  }

  .ai-contact-info__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-contact-info__text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-contact-info__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-contact-info__link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-contact-info__divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px 0;
  }

  .ai-contact-info__footer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.footer_spacing }}px;
    padding-top: {{ block.settings.footer_spacing }}px;
    border-top: 1px solid {{ block.settings.divider_color }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.footer_text_size }}px;
    text-align: {{ block.settings.footer_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-contact-info-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-contact-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-info__content-{{ ai_gen_id }}">
    {% if block.settings.show_phone and block.settings.phone != blank %}
      <div class="ai-contact-info__item-{{ ai_gen_id }}">
        <div class="ai-contact-info__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="ai-contact-info__text-{{ ai_gen_id }}">
          <a href="tel:{{ block.settings.phone }}" class="ai-contact-info__link-{{ ai_gen_id }}">
            {{ block.settings.phone }}
          </a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_email and block.settings.email != blank %}
      <div class="ai-contact-info__item-{{ ai_gen_id }}">
        <div class="ai-contact-info__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="ai-contact-info__text-{{ ai_gen_id }}">
          <a href="mailto:{{ block.settings.email }}" class="ai-contact-info__link-{{ ai_gen_id }}">
            {{ block.settings.email }}
          </a>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_address and block.settings.address != blank %}
      <div class="ai-contact-info__item-{{ ai_gen_id }}">
        <div class="ai-contact-info__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div class="ai-contact-info__text-{{ ai_gen_id }}">
          {{ block.settings.address }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_hours and block.settings.hours != blank %}
      <div class="ai-contact-info__item-{{ ai_gen_id }}">
        <div class="ai-contact-info__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="ai-contact-info__text-{{ ai_gen_id }}">
          {{ block.settings.hours }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_footer_text and block.settings.footer_text != blank %}
      <div class="ai-contact-info__footer-{{ ai_gen_id }}">
        {{ block.settings.footer_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact information",
  "settings": [
    {
      "type": "header",
      "content": "Phone"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+20 123 456 7890"
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "contact@example.com"
    },
    {
      "type": "header",
      "content": "Address"
    },
    {
      "type": "checkbox",
      "id": "show_address",
      "label": "Show address",
      "default": true
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Main Street, Cairo, Egypt"
    },
    {
      "type": "header",
      "content": "Business hours"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours",
      "default": "Sunday - Thursday: 9:00 AM - 6:00 PM"
    },
    {
      "type": "header",
      "content": "Footer text"
    },
    {
      "type": "checkbox",
      "id": "show_footer_text",
      "label": "Show footer text",
      "default": true
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "<p>Or contact us via email at tovee.cosmetics@gmail.com</p>"
    },
    {
      "type": "select",
      "id": "footer_alignment",
      "label": "Footer text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Item spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "footer_spacing",
      "label": "Footer spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2e0808"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#4A1313"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#4A1313"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#EADDDD"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "footer_text_size",
      "label": "Footer text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "Contact information"
    }
  ]
}
{% endschema %}