{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {%- unless cart.empty? -%}
            {% render 'free-shipping-bar' %}
          {%- endunless -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <div class="cart-drawer__scroll-wrap">
                <scroll-hint
                  class="cart-drawer__content"
                  aria-label="{{ 'accessibility.cart' | t }}"
                >
                  <scroll-hint class="cart-drawer__items">
                    {% render 'cart-products', context: 'drawer' %}
                  </scroll-hint>

                  {% render 'cart-routine-recommendations' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </div>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__scroll-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow: visible;
    flex-shrink: 0;
  }

  .cart-drawer__content .cdr-routine {
    width: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-md);

    position: relative;
    flex-shrink: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--gap-sm);
    padding: var(--cart-drawer-summary-padding) var(--cart-drawer-padding);
    margin-top: 0;
    background-color: var(--color-background);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    box-shadow: 0 -6px 16px rgb(var(--color-foreground-rgb) / 0.06);

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-lg);
    }
  }

  .cart-drawer__summary .cart-totals {
    gap: var(--gap-sm);
  }

  .cart-drawer__summary .cart-actions {
    border-block: none;
    margin-block-start: 0;
  }

  .cart-drawer__summary .cart-actions summary {
    padding-block: var(--padding-2xs);
    min-height: auto;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__label {
    display: block;
    font-size: var(--font-size--xs);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__content {
    height: auto;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__form {
    padding-block: 0;
    gap: var(--padding-xs);
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__input {
    padding: 7px 10px;
    font-size: var(--font-size--xs);
    min-height: 34px;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__button {
    min-height: 34px;
    padding: 7px 12px;
    font-size: var(--font-size--xs);
    white-space: nowrap;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__codes {
    margin-top: 6px;
  }

  .cart-drawer__summary .cart-discount--drawer-open .cart-discount__pill {
    padding: 4px 8px;
    font-size: var(--font-size--2xs);
  }

  .cart-drawer__summary .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-2xs);
    line-height: 1.2;
    min-height: auto;
  }

  .cart-drawer__summary .cart-totals__total-label {
    font-size: var(--font-size--xs);
  }

  .cart-drawer__summary .cart-totals__total-value {
    font-size: var(--font-size--md);
  }

  .cart-drawer__summary .cart-totals__tax-note {
    line-height: 1.35;
  }

  .cart-drawer__summary .cart-totals__tax-note small {
    font-size: 0.68rem;
  }

  .cart-drawer__summary .cart__ctas {
    gap: 8px;
  }

  .cart-drawer__summary .cart__ctas .cart__checkout-button,
  .cart-drawer__summary .cart__ctas .cart__view-cart-button {
    height: 42px;
    min-height: 42px;
    padding-inline: var(--padding-lg);
    font-size: var(--font-size--sm);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: none;
    padding-block-start: 0;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: relative;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: visible;
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* ── Cart Drawer Routine Suggestions Slider (Screenshot Style) ── */
  .cart-drawer__routine {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 0;
    margin: 16px var(--cart-drawer-padding);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-drawer__routine-title {
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    font-weight: 500;
    text-align: center;
    color: var(--color-brand-dark, #2e0808);
    margin: 16px 0 12px 0;
    letter-spacing: 0.01em;
  }

  .cart-drawer__routine-slider {
    position: relative;
    overflow: hidden;
  }

  .cart-drawer__routine-slides {
    display: flex;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    width: 100%;
  }

  .cart-drawer__routine-slide {
    flex: 0 0 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 16px 14px 16px;
    gap: 12px;
    box-sizing: border-box;
  }

  .cart-drawer__routine-product {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .cart-drawer__routine-img {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.03);
  }

  .cart-drawer__routine-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cart-drawer__routine-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .cart-drawer__routine-name {
    font-family: var(--font-body--family);
    font-size: 0.82rem;
    font-weight: 500;
    color: #1e1e1e;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .cart-drawer__routine-price {
    font-family: var(--font-body--family);
    font-size: 0.82rem;
    font-weight: 500;
    color: #1e1e1e;
    line-height: 1.3;
  }

  .cart-drawer__routine-action {
    width: 100%;
  }

  .cart-drawer__routine-form {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .cart-drawer__routine-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
  }

  /* Wide dark button matching brand styling */
  .cart-drawer__routine-submit-btn {
    flex: 1;
    height: 34px;
    border-radius: 30px;
    background: var(--color-brand-dark, #2e0808);
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.1s;
  }

  .cart-drawer__routine-submit-btn:hover {
    background: var(--color-brand-burgundy, #5c1a1a);
    transform: translateY(-0.5px);
  }

  /* Navigation Footer Styling */
  .cart-drawer__routine-nav {
    display: flex;
    align-items: center;
    border-top: 1px solid #eaeaea;
    height: 38px;
    background: #ffffff;
  }

  .cart-drawer__routine-prev,
  .cart-drawer__routine-next {
    width: 44px;
    height: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    transition: color 0.2s;
    padding: 0;
  }

  .cart-drawer__routine-prev:hover,
  .cart-drawer__routine-next:hover {
    color: #1e1e1e;
  }

  .cart-drawer__routine-prev {
    border-right: 1px solid #eaeaea;
  }

  .cart-drawer__routine-next {
    border-left: 1px solid #eaeaea;
  }

  .cart-drawer__routine-dots {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .cart-drawer__routine-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid #bbb;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
    padding: 0;
  }

  .cart-drawer__routine-dot.active {
    background: #1e1e1e;
    border-color: #1e1e1e;
  }
{% endstylesheet %}

