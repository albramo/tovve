{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="tovee-page section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div class="tovee-page__inner spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% if section.settings.show_banner %}
      <div class="tovee-page__banner">
        <p class="tovee-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 class="tovee-page__title">{{ section.settings.title }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="tovee-page__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% else %}
      <h1 class="tovee-page__title tovee-page__title--plain">{{ section.settings.title }}</h1>
    {% endif %}

    <div class="tovee-page__content rte">
      {{ section.settings.content }}
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="tovee-page__cta">
        <a href="{{ section.settings.button_link }}" class="tovee-page__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .tovee-page {
    padding-block: 48px 80px;
  }

  .tovee-page__inner {
    max-width: 720px;
    margin-inline: auto;
  }

  .tovee-page__banner {
    text-align: center;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .tovee-page__eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-brand-mahogany);
    margin: 0 0 12px;
  }

  .tovee-page__title {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
    margin: 0;
    color: var(--color-foreground);
  }

  .tovee-page__title--plain {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .tovee-page__subtitle {
    font-family: var(--font-body--family);
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    margin: 16px 0 0;
    max-width: 520px;
    margin-inline: auto;
  }

  .tovee-page__content {
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.75;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .tovee-page__content h2 {
    font-family: var(--font-heading--family);
    font-size: 1.35rem;
    margin: 40px 0 12px;
    color: var(--color-foreground);
  }

  .tovee-page__content h2:first-child {
    margin-top: 0;
  }

  .tovee-page__content p {
    margin: 0 0 16px;
  }

  .tovee-page__content ul,
  .tovee-page__content ol {
    margin: 0 0 20px;
    padding-inline-start: 1.25rem;
  }

  .tovee-page__content li {
    margin-bottom: 8px;
  }

  .tovee-page__content a {
    color: var(--color-brand-mahogany);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tovee-page__cta {
    margin-top: 40px;
    text-align: center;
  }

  .tovee-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: 999px;
    background: var(--color-brand-dark);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .tovee-page__button:hover {
    background: var(--color-brand-burgundy);
    color: #fff;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    .tovee-page {
      padding-block: 32px 56px;
    }

    .tovee-page__banner {
      margin-bottom: 32px;
      padding-bottom: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tovee Page",
  "tag": "section",
  "class": "tovee-page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Tovee"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Page Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your page content here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FCFAF8"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tovee Page"
    }
  ]
}
{% endschema %}
