{% comment %}
  Section: All Collections Grid
  Displays every collection in a responsive grid.
  Mobile‑first, uses existing theme variables for colors & fonts.
{% endcomment %}

<div class="all-collections-grid">
  {% for collection in collections.all %}
    <a href="{{ collection.url }}" class="collection-card">
      {% if collection.image %}
        <picture class="collection-card__image">
          <img src="{{ collection.image | img_url: '540x540' }}" alt="{{ collection.title }}" loading="lazy" />
        </picture>
      {% else %}
        <div class="collection-card__placeholder"></div>
      {% endif %}
      <div class="collection-card__info">
        <h2 class="collection-card__title">{{ collection.title }}</h2>
        {% if collection.description != blank %}
          <p class="collection-card__desc">{{ collection.description | strip_html | truncate: 120 }}</p>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>

{% stylesheet %}
  .all-collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacing-medium, 24px);
    padding-block: var(--spacing-large, 48px);
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-background, #fff);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 12px rgb(var(--color-brand-dark-rgb) / 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(var(--color-brand-dark-rgb) / 0.12);
  }

  .collection-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* mobile full‑width image */
    display: block;
  }

  .collection-card__placeholder {
    background: var(--color-border-soft);
    aspect-ratio: 1;
  }

  .collection-card__info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .collection-card__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    margin: 0;
    color: var(--color-brand-dark);
    transition: color 0.2s ease;
  }

  .collection-card:hover .collection-card__title {
    color: var(--color-brand-primary);
  }

  .collection-card__desc {
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media screen and (max-width: 749px) {
    .all-collections-grid {
      grid-template-columns: 1fr;
    }
    .collection-card__image img {
      object-fit: contain; /* show whole image on mobile */
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "All Collections Grid",
  "tag": "section",
  "settings": []
}
{% endschema %}
