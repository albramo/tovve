{%- liquid
  assign current_article_id = article.id
  assign related_limit = 3
  assign counter = 0
-%}

<div class="related-articles-section">
  <div class="related-articles__container container mx-auto px-4">
    <h2 class="related-articles__heading text-center">
      {{ section.settings.heading | default: 'مقالات ذات صلة' }}
    </h2>

    <div class="related-articles__grid">
      {%- for rel_article in blog.articles -%}
        {%- if rel_article.id != current_article_id and counter < related_limit -%}
          {%- assign counter = counter | plus: 1 -%}
          <a href="{{ rel_article.url }}" class="related-articles__card-link">
            <div class="related-articles__card">
              <div class="related-articles__image-wrapper">
                {%- if rel_article.image -%}
                  {{
                    rel_article.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'related-articles__image',
                      widths: '300, 450, 600'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'related-articles__image placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="related-articles__card-content">
                <span class="related-articles__tag">
                  {%- if rel_article.tags.size > 0 -%}
                    in {{ rel_article.tags.first }}
                  {%- else -%}
                    in {{ blog.title }}
                  {%- endif -%}
                </span>
                <h3 class="related-articles__title">
                  {{ rel_article.title }}
                </h3>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .related-articles-section {
    padding-block: 50px;
    background-color: var(--color-background, #fff);
    border-top: 1px solid rgba(0,0,0,0.08);
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
  }

  .related-articles__container {
    max-width: 1300px;
    margin-inline: auto;
  }

  .related-articles__heading {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 35px;
    text-align: center;
    color: var(--color-foreground, #000);
    letter-spacing: -0.02em;
  }

  .related-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 989px) {
    .related-articles__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    /* Hide the 3rd card on tablets to maintain grid balance */
    .related-articles__grid .related-articles__card-link:nth-child(3) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .related-articles__grid {
      grid-template-columns: 1fr;
    }
    .related-articles__grid .related-articles__card-link:nth-child(3) {
      display: block; /* Show all on single column mobile */
    }
  }

  .related-articles__card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .related-articles__card-link:hover {
    transform: translateY(-4px);
  }

  .related-articles__card {
    position: relative;
    background: #121212;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    border: none;
    height: 0;
    padding-bottom: 75%; /* 4:3 Aspect Ratio matching premium theme hero */
    display: block;
  }

  .related-articles__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #000;
  }

  .related-articles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .related-articles__card-link:hover .related-articles__image {
    transform: scale(1.08);
  }

  .related-articles__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    z-index: 2;
    box-sizing: border-box;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .related-articles__tag {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 8px;
    text-align: right;
  }

  .related-articles__title {
    font-size: 19px;
    line-height: 1.35;
    font-weight: 700;
    margin: 0;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    text-align: right;
  }

  @media screen and (max-width: 749px) {
    .related-articles-section {
      padding-block: 30px;
    }
    .related-articles__heading {
      font-size: 22px;
      margin-bottom: 25px;
    }
    .related-articles__card-content {
      padding: 16px;
    }
    .related-articles__tag {
      font-size: 11px;
      margin-bottom: 6px;
    }
    .related-articles__title {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Related Articles",
  "tag": "section",
  "class": "related-articles-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "مقالات ذات صلة"
    }
  ],
  "presets": [
    {
      "name": "Related Articles"
    }
  ]
}
{% endschema %}